# EliteOps Lead Intelligence Environment Template (.env.example)

# Database & Cache Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/eliteops_leads?schema=public"
REDIS_URL="redis://localhost:6379"

# AI Intelligence & OpenAI Key
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# Live Scanner & Platform Connectors
LINKEDIN_API_KEY="your-linkedin-api-key"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

UPWORK_API_KEY="your-upwork-api-key"
UPWORK_CLIENT_SECRET="your-upwork-client-secret"

FREELANCER_API_KEY="your-freelancer-api-token"

GOOGLE_SEARCH_API_KEY="your-google-search-api-key"
GOOGLE_SEARCH_CX="your-google-search-engine-id"

# Server URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
